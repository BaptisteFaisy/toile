# Toile — image/toile.build
#
# Image QNX invitée GRAPHIQUE minimale : noyau + serveur PCI + pilote Toile
# (/dev/gpu0) + serveur Screen + une appli de démo (la mire).
#
# Construction (SDP QNX 8.0 installé, 2026-11-12) :
#   source ~/qnx800/qnxsdp-env.sh
#   make -f guest/common.mk                 # produit guest/build/toile-gpu
#                                             # et guest/build/toile-display
#   mkifs image/toile.build /tmp/toile.ifs
#
# Lancement (hôte QEMU) :
#   qemu-system-x86_64 --enable-kvm --cpu host -m 2048 \
#       -kernel /tmp/toile.ifs -vga none -device virtio-gpu-pci \
#       -display none -serial mon:stdio
#
# io-pkt n'est PAS requis (aucun réseau dans cette image).
#
# LIMITES CONNUES (documentées, non cachées) :
#  - le bureau QNX complet (polices, gestionnaires de fenêtres, /system) vit
#    dans la partition /system de l'image QSTI ; cette IFS est autonome mais
#    ne contient pas les ressources graphiques de /system.  Pour une démo
#    « bureau », il faut l'image QSTI (~/qnx800/images/qemu) + Toile
#    installé dans /system, ou une image CTI construite sur cette base ;
#  - Screen a besoin de ses greffons : ici screen-sw.so (rendu logiciel) ;
#    le greffon matériel de QNX 8.0 pour virtio est `drm-virtio`
#    (documenté dans le SDP, rscreen_drm.html), non embarqué ici.

[search=${QNX_TARGET}/x86_64/boot/sys:${QNX_TARGET}/x86_64/bin:${QNX_TARGET}/x86_64/sbin:${QNX_TARGET}/x86_64/usr/bin:${QNX_TARGET}/x86_64/usr/sbin:${QNX_TARGET}/x86_64/usr/lib:${QNX_TARGET}/x86_64/lib:${QNX_TARGET}/x86_64/lib/dll:${QNX_TARGET}/x86_64/lib/dll/pci:guest/build]

[virtual=x86_64,multiboot] boot = {
    startup-x86 -D8250..115200
    PATH=/proc/boot
    LD_LIBRARY_PATH=/proc/boot
    [+keeplinked] procnto-smp-instr -mr -d 022 -u 066
}

[+script] startup-script = {
    TERM=qansi
    HOME=/proc/boot
    PCI_BKWD_COMPAT_MODULE=/proc/boot/pci_bkwd_compat.so
    PCI_SLOG_MODULE=pci_slog2.so
    PCI_DEBUG_MODULE=pci_debug2.so
    PCI_CAP_MODULE_DIR=/proc/boot
    devc-ser8250 -e
    pci-server --aspace-enable --config=/proc/boot/pci_server.cfg
    waitfor /dev/pci/server_id_1
    # --- pilote Toile : il crée /dev/gpu0 ------------------------------
    /proc/boot/toile-gpu --mire &
    waitfor /dev/gpu0
    # --- serveur graphique : nécessite un greffon d'affichage (drm-virtio
    #     n'est pas dans cette IFS : le serveur signalera l'absence de
    #     greffon, ce qui est attendu et documenté) ---------------------
    /proc/boot/screen &
    # --- démo : mire peinte dans le framebuffer virtio-gpu --------------
    /proc/boot/toile-display --fb
    on -d -t /dev/ser1 ksh -l
}

# --- noyau et outils --------------------------------------------------------
ksh
on
waitfor
devc-ser8250
pci-server
pci-tool
devinfo
pidin
devb-eide
io-blk.so
fs-qnx6.so
cam-disk.so
screen
screen-sw.so

# --- bibliothèques partagées -------------------------------------------------
# NEEDED relevés avec `readelf -d` sur screen, devb-eide et nos binaires
# (mkifs ne résout pas les dépendances tout seul).
ldqnx-64.so.2
libc.so.6
libgcc_s.so.1
libsecpol.so.1
libpci.so.3.0
libsocket.so.4
libslog2.so.1
libscrmem.so.1
libmemobj.so.1
libcam.so.2
libWFD.so.1
libscreen.so

# --- modules PCI -------------------------------------------------------------
pci_bkwd_compat.so
pci_slog2.so
pci_debug2.so
pci_hw-Intel_x86.so
pci_cap-0x01.so
pci_cap-0x04.so
pci_cap-0x05.so
pci_cap-0x07.so
pci_cap-0x09-ffffffff.so
pci_cap-0x0d.so
pci_cap-0x10.so
pci_cap-0x11.so
pci_cap-0x12.so
pci_cap-0x13.so

[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/ldqnx-64.so.2
[type=link] /lib/libc.so.6=/proc/boot/libc.so.6
[type=link] /lib/libgcc_s.so.1=/proc/boot/libgcc_s.so.1
[type=link] /lib/libsecpol.so.1=/proc/boot/libsecpol.so.1
[type=link] /lib/libpci.so.3.0=/proc/boot/libpci.so.3.0
[type=link] /lib/libsocket.so.4=/proc/boot/libsocket.so.4

# --- configuration du serveur PCI (contenu de l'image QSTI installée) ------
[type=file] /proc/boot/pci_server.cfg = {
    [buscfg]
    DO_BUS_CONFIG=no

    [envars]
    PCI_DEBUG_MODULE=pci_debug2.so
    PCI_HW_MODULE=pci_hw-Intel_x86.so
    PCI_HW_CONFIG_FILE=/proc/boot/pci_hw.cfg
}

[type=file] /proc/boot/pci_hw.cfg = {
    [interrupts]
    B0:D17:F0    A    18
    B0:D17:F0    B    19
    B0:D17:F0    C    16
    B0:D17:F0    D    17
    B3:D0:F0     A    18
    B3:D0:F0     B    19
    B3:D0:F0     C    16
    B3:D0:F0     D    17
}

# --- pilote Toile et démo (produits par guest/common.mk) -------------------
# Ces deux binaires doivent exister AVANT mkifs ; ils sont trouvés via le
# chemin de recherche « guest/build » (relatif : lancer mkifs depuis la
# racine du dépôt).
[+keeplinked] toile-gpu
[+keeplinked] toile-display

# Toile — image/toile-e1.build
#
# Image QNX invitée MINIMALE pour la sonde E1 (énumération PCI du
# périphérique virtio-gpu dans l'invité).  Elle ne contient ni disque ni
# bureau : seulement le noyau, le serveur PCI, l'outil pci-tool et un
# interpréteur de commandes sur la ligne série.
#
# Construction (SDP QNX 8.0 installé) :
#   source ~/qnx800/qnxsdp-env.sh
#   mkifs image/toile-e1.build /tmp/toile-e1.ifs
#
# Lancement (hôte QEMU) :
#   qemu-system-x86_64 --enable-kvm --cpu host -m 2048 \
#       -kernel /tmp/toile-e1.ifs -vga none -device virtio-gpu-pci \
#       -display none -serial mon:stdio
#
# La sonde affiche entre les marqueurs === TOILE_E1_PROBE_BEGIN === et
# === TOILE_E1_PROBE_END === la sortie de pci-tool et de devinfo.

[search=${QNX_TARGET}/x86_64/boot/sys:${QNX_TARGET}/x86_64/bin:${QNX_TARGET}/x86_64/sbin:${QNX_TARGET}/x86_64/usr/bin:${QNX_TARGET}/x86_64/usr/sbin:${QNX_TARGET}/x86_64/usr/lib:${QNX_TARGET}/x86_64/lib:${QNX_TARGET}/x86_64/lib/dll/pci]

[virtual=x86_64,multiboot] boot = {
    startup-x86 -D8250..115200
    PATH=/proc/boot
    LD_LIBRARY_PATH=/proc/boot
    [+keeplinked] procnto-smp-instr -mr -d 022 -u 066
}

[+script] startup-script = {
    TERM=qansi
    HOME=/proc/boot
    PCI_BKWD_COMPAT_MODULE=/proc/boot/pci_bkwd_compat.so
    PCI_SLOG_MODULE=pci_slog2.so
    PCI_DEBUG_MODULE=pci_debug2.so
    PCI_CAP_MODULE_DIR=/proc/boot
    devc-ser8250 -e
    pci-server --aspace-enable --config=/proc/boot/pci_server.cfg
    waitfor /dev/pci/server_id_1
    ksh /proc/boot/probe.sh
    on -d -t /dev/ser1 ksh -l
}

# --- configuration du serveur PCI ------------------------------------------
# Contenu repris de l'image QNX Everywhere (QSTI) installée dans le SDP :
# output/build/ifs.build de ~/qnx800/images/qemu (relu le 2026-11-12).
[type=file] /proc/boot/pci_server.cfg = {
    [buscfg]
    DO_BUS_CONFIG=no

    [envars]
    PCI_DEBUG_MODULE=pci_debug2.so
    PCI_HW_MODULE=pci_hw-Intel_x86.so
    PCI_HW_CONFIG_FILE=/proc/boot/pci_hw.cfg
}

[type=file] /proc/boot/pci_hw.cfg = {
    [interrupts]
    B0:D17:F0    A    18
    B0:D17:F0    B    19
    B0:D17:F0    C    16
    B0:D17:F0    D    17
    B3:D0:F0     A    18
    B3:D0:F0     B    19
    B3:D0:F0     C    16
    B3:D0:F0     D    17
}

# --- binaires (les dépendances partagées sont listées ci-dessous) --------
ksh
on
waitfor
devc-ser8250
pci-server
pci-tool
devinfo
pidin
pci_bkwd_compat.so
pci_slog2.so
pci_debug2.so
pci_hw-Intel_x86.so
pci_cap-0x01.so
pci_cap-0x04.so
pci_cap-0x05.so
pci_cap-0x07.so
pci_cap-0x09-ffffffff.so
pci_cap-0x0d.so
pci_cap-0x10.so
pci_cap-0x10-16c3abcd.so
pci_cap-0x10-19570400.so
pci_cap-0x11.so
pci_cap-0x11-ffffffff.so
pci_cap-0x12.so
pci_cap-0x13.so
pcie_xcap-0x0001.so
pcie_xcap-0x0003.so
pcie_xcap-0x000b-ffffffff.so
pcie_xcap-0x0015.so

# --- bibliothèques partagées (ELIBACC 83 sinon) ---------------------------
# NEEDED vérifié avec readelf -d sur les binaires ci-dessus.
ldqnx-64.so.2
libc.so.6
libgcc_s.so.1
libsecpol.so.1
libpci.so.3.0
libsocket.so.4

[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/ldqnx-64.so.2
[type=link] /lib/libc.so.6=/proc/boot/libc.so.6
[type=link] /lib/libgcc_s.so.1=/proc/boot/libgcc_s.so.1
[type=link] /lib/libsecpol.so.1=/proc/boot/libsecpol.so.1
[type=link] /lib/libpci.so.3.0=/proc/boot/libpci.so.3.0
[type=link] /lib/libsocket.so.4=/proc/boot/libsocket.so.4

# --- sonde E1 ---------------------------------------------------------------
[type=file] /proc/boot/probe.sh = {
    #!/bin/ksh
    echo "=== TOILE_E1_PROBE_BEGIN ==="
    echo "--- pci-tool ---"
    pci-tool 2>&1
    echo "--- pci-tool -v ---"
    pci-tool -v 2>&1
    echo "--- devinfo ---"
    devinfo 2>&1
    echo "=== TOILE_E1_PROBE_END ==="
}
